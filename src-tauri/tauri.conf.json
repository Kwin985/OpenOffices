{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenOffices",
  "version": "0.16.0",
  "identifier": "com.openoffices.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenOffices 办公套件",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": ["xlsx", "xls", "ods", "csv"],
        "name": "Spreadsheet Document",
        "description": "OpenOffices 表格文档",
        "role": "Editor"
      },
      {
        "ext": ["docx", "odt", "odoc"],
        "name": "Text Document",
        "description": "OpenOffices 文档",
        "role": "Editor"
      },
      {
        "ext": ["pptx", "ppt", "opd"],
        "name": "Presentation",
        "description": "OpenOffices 演示",
        "role": "Editor"
      },
      {
        "ext": ["pdf"],
        "name": "PDF Document",
        "description": "PDF 文档（只读查看）",
        "role": "Viewer"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
