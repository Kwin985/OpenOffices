{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenOffices",
  "version": "0.84.0",
  "identifier": "com.openoffices.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenOffices 办公套件",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhDMUM1RUQ2NDU5NEUwRkEKUldUNjRKUkYxbDRjakl6b1dhWkYrdmFsVXhQcUF2a2p6THJmWTQvUWYybHlqc2xoKzFUZDBXOTYK",
      "endpoints": [
        "https://github.com/Kwin985/OpenOffices/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": ["xlsx", "xls", "ods", "csv"],
        "name": "Spreadsheet Document",
        "description": "OpenOffices Spreadsheet Document",
        "role": "Editor"
      },
      {
        "ext": ["docx", "odt", "odoc"],
        "name": "Text Document",
        "description": "OpenOffices Text Document",
        "role": "Editor"
      },
      {
        "ext": ["pptx", "ppt", "opd"],
        "name": "Presentation",
        "description": "OpenOffices Presentation",
        "role": "Editor"
      },
      {
        "ext": ["pdf"],
        "name": "PDF Document",
        "description": "PDF Document (read-only viewer)",
        "role": "Viewer"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
